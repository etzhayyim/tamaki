{:paths [".mirror/src" "src"]
 ;; .mirror/src is the generated .clj symlink overlay for the JVM require
 ;; probes (bb / clojure see .bb .clj .cljc, never .cljk — measured
 ;; 2026-09-22/23). Regenerated by bin/gen-cljk-mirror, refreshed by
 ;; bin/tamaki on every launch; missing or stale simply behaves like no
 ;; overlay (kbb resolves .cljk natively and ignores it).
 :deps {
        ;; kotoba.lang.error replaced clojure.lang.ExceptionInfo here (2026-09-25).
        ;; An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/error
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "febd87e46c4fc66df9d51b61f717e656e70a17c4"
         :deps/root "lib/kotoba.error"}
        ;; kotoba.bytes replaced UTF-8 .getBytes / String. here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "febd87e46c4fc66df9d51b61f717e656e70a17c4"
         :deps/root "lib/kotoba.bytes"}
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "febd87e46c4fc66df9d51b61f717e656e70a17c4"
         :deps/root "lib/kotoba.io"}
        ;; kotoba.pprint replaced clojure.pprint here (2026-09-24): the same
        ;; bytes (cljs.pprint transcribed). An explicit floor; tools.deps takes the
        ;; NEWEST sha it is shown.
        io.github.kotoba-lang/pprint
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "febd87e46c4fc66df9d51b61f717e656e70a17c4"
         :deps/root "lib/kotoba.pprint"}
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "febd87e46c4fc66df9d51b61f717e656e70a17c4"
         :deps/root "lib/kotoba.coll"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "febd87e46c4fc66df9d51b61f717e656e70a17c4"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "febd87e46c4fc66df9d51b61f717e656e70a17c4"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "febd87e46c4fc66df9d51b61f717e656e70a17c4"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/json
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "febd87e46c4fc66df9d51b61f717e656e70a17c4"
         :deps/root "lib/kotoba.json"}        io.github.kotoba-lang/kotoba-core-contracts
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "febd87e46c4fc66df9d51b61f717e656e70a17c4"
         :deps/root "lib/kotoba.kotobaCoreContracts"}
        io.github.kotoba-lang/hil
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "febd87e46c4fc66df9d51b61f717e656e70a17c4"
         :deps/root "lib/kotoba.hil"}
        ;; The AO model this repo defined and then handed to shared libraries
        ;; (ADR-0001 / ADR-0002). kotoba.tamaki.model and .lineage are now
        ;; adapters over these, in the same shape kotoba.tamaki.capability
        ;; already had over kotoba-core-contracts.
        io.github.kotoba-lang/ao
        {:git/url "https://github.com/kotoba-lang/ao.git"
         :git/sha "188b3062959bebc1254c4d6079112233f0f260b6"}
        io.github.kotoba-lang/agent
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "febd87e46c4fc66df9d51b61f717e656e70a17c4"
         :deps/root "lib/kotoba.agent"}
        io.github.kotoba-lang/org-oasis-open-xmile
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "febd87e46c4fc66df9d51b61f717e656e70a17c4"
         :deps/root "lib/org.oasisOpen.xmile"}
        io.github.kotoba-lang/yakuwari
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "febd87e46c4fc66df9d51b61f717e656e70a17c4"
         :deps/root "lib/kotoba.yakuwari"}}
 :aliases
 {:run {:main-opts ["-m" "kotoba.tamaki.cli"]}
  :test {:extra-paths [".mirror/test" "test"]
         :main-opts ["-m" "kotoba.tamaki.test-runner"]
         :exec-fn kotoba.tamaki.test-runner/run}}}
