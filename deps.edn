{:paths [".mirror/src" "src"]
 ;; .mirror/src is the generated .clj symlink overlay for the JVM require
 ;; probes (bb / clojure see .bb .clj .cljc, never .cljk — measured
 ;; 2026-09-22/23). Regenerated by bin/gen-cljk-mirror, refreshed by
 ;; bin/tamaki on every launch; missing or stale simply behaves like no
 ;; overlay (kbb resolves .cljk natively and ignores it).
 :deps {
        ;; kotoba.bytes replaced UTF-8 .getBytes / String. here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes {:git/sha "d5259f35ab7c4f5a66e63ca29ed4dcf7ba3f1ac5"}
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io {:git/sha "1b60ca825c1e705bd195f857ca4549133653a9f3"}
        ;; kotoba.pprint replaced clojure.pprint here (2026-09-24): the same
        ;; bytes (cljs.pprint transcribed). An explicit floor; tools.deps takes the
        ;; NEWEST sha it is shown.
        io.github.kotoba-lang/pprint {:git/sha "5c9d4aea71d6caac529fffcf361aba0f87ee485e"}
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "f74e248f0a07e8ae572885f50fab6bdb39dc24be"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/json {:git/sha "4c55a247b020bfb1c7b5b09f9df8f3fa5601a207"}        io.github.kotoba-lang/kotoba-core-contracts
        {:git/url "https://github.com/kotoba-lang/kotoba-core-contracts.git"
         :git/sha "2e615d17406ef4b6311401167294becceb5af2a1"}
        io.github.kotoba-lang/hil {:git/url "https://github.com/kotoba-lang/hil.git"
         :git/sha "75f5b9ed3ed00161f331f868a224d3a71e5db00e"}
        ;; The AO model this repo defined and then handed to shared libraries
        ;; (ADR-0001 / ADR-0002). kotoba.tamaki.model and .lineage are now
        ;; adapters over these, in the same shape kotoba.tamaki.capability
        ;; already had over kotoba-core-contracts.
        io.github.kotoba-lang/ao
        {:git/url "https://github.com/kotoba-lang/ao.git"
         :git/sha "188b3062959bebc1254c4d6079112233f0f260b6"}
        io.github.kotoba-lang/agent
        {:git/url "https://github.com/kotoba-lang/agent.git"
         :git/sha "d96c50cfdea4d27fecbb3e05203038f908ed6a0c"}
        io.github.kotoba-lang/org-oasis-open-xmile
        {:git/url "https://github.com/kotoba-lang/org-oasis-open-xmile.git"
         :git/sha "9a703008784b2c46d2f7289d78438c450b47d906"}
        io.github.kotoba-lang/yakuwari
        {:git/url "https://github.com/kotoba-lang/yakuwari.git"
         :git/sha "6d340871419d0ad33d401b7128ed297148930082"}}
 :aliases
 {:run {:main-opts ["-m" "kotoba.tamaki.cli"]}
  :test {:extra-paths [".mirror/test" "test"]
         :main-opts ["-m" "kotoba.tamaki.test-runner"]
         :exec-fn kotoba.tamaki.test-runner/run}}}
