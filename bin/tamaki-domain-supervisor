#!/usr/bin/env bash
set -euo pipefail

tamaki_root="$(cd "$(dirname "$0")/.." && pwd)"
interval_seconds="${TAMAKI_DOMAIN_INTERVAL_SECONDS:-300}"
workspace_root="${TAMAKI_WORKSPACE:-${COM_JUNKAWASAKI_ROOT:-$(cd "$tamaki_root/../../.." && pwd)}}"
control_root="${TAMAKI_CONTROL_ROOT:-$workspace_root/projects/.tamaki/tamaki-control}"
actor_dir="${TAMAKI_ACTOR_SPEC_DIR:-$control_root/actors}"
collector_dir="${TAMAKI_COLLECTOR_SPEC_DIR:-$control_root/collectors}"
reaction_collector_dir="${TAMAKI_REACTION_COLLECTOR_SPEC_DIR:-$collector_dir/content}"
concurrency="${TAMAKI_DOMAIN_CONCURRENCY:-3}"
cd "$tamaki_root"
export TAMAKI_WORKSPACE="$workspace_root"
export TAMAKI_WORKSPACE_ROOT="$workspace_root"
# Business observations must enter the same durable stream consumed by the
# portfolio supervisor and Observatory. A caller may still isolate a test or
# staging plane explicitly, but the resident default is the canonical local
# Tamaki state.
export TAMAKI_STATE_DIR="${TAMAKI_STATE_DIR:-$tamaki_root/.tamaki}"

if [[ ! -d "$actor_dir" ]]; then
  echo "Tamaki control actor directory not found: $actor_dir" >&2
  echo "Set TAMAKI_CONTROL_ROOT or TAMAKI_ACTOR_SPEC_DIR." >&2
  exit 2
fi
if ! [[ "$concurrency" =~ ^[1-9][0-9]*$ ]]; then
  echo "TAMAKI_DOMAIN_CONCURRENCY must be a positive integer" >&2
  exit 2
fi

index=0
while true; do
  specs=()
  for candidate in "$actor_dir"/*.edn; do
    [[ -f "$candidate" ]] || continue
    grep -q ':actor/type :business-domain' "$candidate" || continue
    specs+=("$candidate")
  done
  if [[ "${#specs[@]}" -eq 0 ]]; then
    echo "No ActorSpecs found in $actor_dir" >&2
    exit 2
  fi
  pids=()
  count="${#specs[@]}"
  batch="$concurrency"
  (( batch > count )) && batch="$count"
  for ((offset=0; offset<batch; offset++)); do
    spec="${specs[$(((index + offset) % count))]}"
    collector="$collector_dir/$(basename "$spec")"
    if [[ -f "$collector" ]]; then
      # A stale or unavailable provider must not stop code/reliability work.
      # `kpi collect` records zero confidence and exits non-zero when stale.
      bin/tamaki kpi collect --spec "$collector" \
        --targets "$control_root/business-targets.edn" || true
    fi
    reaction_collector="$reaction_collector_dir/$(basename "$spec")"
    if [[ -f "$reaction_collector" ]]; then
      # Provider export jobs own these local snapshots. Missing data is
      # explicitly unavailable and must never be replaced by synthetic facts.
      bin/tamaki content collect --spec "$reaction_collector" || true
    fi
    bin/tamaki actor reconcile "$spec" --execute &
    pids+=("$!")
  done
  for pid in "${pids[@]}"; do
    wait "$pid" || true
  done
  index=$(((index + batch) % count))
  sleep "$interval_seconds"
done
