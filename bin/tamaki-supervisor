#!/usr/bin/env bash
set -euo pipefail

tamaki_root="$(cd "$(dirname "$0")/.." && pwd)"
project="${TAMAKI_SUPERVISOR_PROJECT:-$tamaki_root}"
objective="${TAMAKI_SUPERVISOR_OBJECTIVE:-discover and resolve the highest-leverage issue that improves maturity, coverage, reliability, documentation, or sustainable revenue}"
runners="${TAMAKI_SUPERVISOR_RUNNERS:-codex,claude,claude-zai,grok}"
interval_ms="${TAMAKI_SUPERVISOR_INTERVAL_MS:-900000}"
max_failures="${TAMAKI_SUPERVISOR_MAX_FAILURES:-4}"
actor_spec="${TAMAKI_SUPERVISOR_ACTOR_SPEC:-$tamaki_root/actors/revenue-growth.edn}"
actor_interval_seconds="${TAMAKI_ACTOR_RECONCILE_SECONDS:-300}"

cd "$tamaki_root"
loop_id="$(
  bin/tamaki loop ensure \
    --project "$project" \
    --objective "$objective" \
    --runners "$runners" \
    --continuous \
    --interval-ms "$interval_ms" \
    --max-failures "$max_failures" |
  clojure -M -e '(println (:tamaki.loop/id (read)))'
)"

actor_pid=""
cleanup() {
  if [[ -n "$actor_pid" ]] && kill -0 "$actor_pid" 2>/dev/null; then
    kill "$actor_pid" 2>/dev/null || true
    wait "$actor_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

(
  while true; do
    bin/tamaki actor reconcile "$actor_spec" --execute || true
    sleep "$actor_interval_seconds"
  done
) &
actor_pid=$!

bin/tamaki loop run "$loop_id"
