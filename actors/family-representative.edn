{:actor/id :tamaki/family-representative
 :actor/type :tamaki/deterministic-governance
 :actor/project "."
 :actor/objective
 "Represent the Etzhayyim Tamaki family by reconciling the complete repository inventory into one repository-bound AO per repository. Coordinate through reviewed artifacts; never acquire implicit authority over another AO."
 :actor/capabilities #{:family-observation :repository-observation
                       :event-observation}
 :actor/governor :tamaki/human-agency
 :actor/hil-policy {:observe :autonomous
                    :project-local-registry :autonomous
                    :mutate-member-repository :approval-required
                    :change-family-membership :approval-required
                    :cross-ao-credential-access :blocked}
 :actor/scale {:min 0 :desired 0 :max 1}
 :actor/budget {:max-turns 1 :max-tool-calls 1 :max-tokens 0
                :deadline-ms 300000 :test-timeout-ms 120000}
 :actor/runners [{:runner :deterministic :weight 1}]}
